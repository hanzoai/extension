{
  "name": "@hanzo/mcp",
  "version": "2.4.1",
  "private": true,
  "description": "Hanzo MCP Server - Unified tool surface with AI, cloud control, vector search, and multi-framework UI",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "hanzo-mcp": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "server.js",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:lib && npm run build:cli",
    "build:lib": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist/index.js --external:@modelcontextprotocol/sdk --external:glob --external:commander --external:zod --external:zod-to-json-schema --external:mime-types --external:@lancedb/lancedb --external:@xenova/transformers --external:jsautogui --external:path --external:fs --external:fs/promises --external:os --external:url",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist/cli.js --external:@modelcontextprotocol/sdk --external:glob --external:commander --external:zod --external:zod-to-json-schema --external:mime-types --external:@lancedb/lancedb --external:@xenova/transformers --external:jsautogui --external:path --external:fs --external:fs/promises --external:os --external:url && chmod +x dist/cli.js",
    "dev": "tsc --watch",
    "lint": "echo 'No linter configured'",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "claude",
    "tools",
    "development"
  ],
  "author": "Hanzo AI",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@types/mime-types": "catalog:",
    "commander": "catalog:",
    "glob": "catalog:",
    "mime-types": "catalog:",
    "minimatch": "catalog:",
    "zod": "catalog:",
    "zod-to-json-schema": "catalog:"
  },
  "optionalDependencies": {
    "@lancedb/lancedb": "catalog:",
    "@xenova/transformers": "catalog:",
    "jsautogui": "catalog:",
    "playwright": "catalog:",
    "playwright-core": "catalog:"
  },
  "devDependencies": {
    "@types/glob": "catalog:",
    "@types/minimatch": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/mcp.git"
  },
  "homepage": "https://hanzo.ai",
  "bugs": {
    "url": "https://github.com/hanzoai/mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
