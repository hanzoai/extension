{
  "name": "@hanzo/gitlab",
  "version": "1.0.1",
  "description": "Hanzo AI on GitLab \u2014 a webhook service that reviews merge requests, triages issues, and answers @hanzo mentions, built on @hanzo/ai and @hanzo/iam.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@hanzo/ai": "catalog:",
    "@hanzo/iam": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "keywords": [
    "hanzo",
    "gitlab",
    "webhook",
    "merge-request",
    "code-review",
    "issue-triage",
    "ai"
  ],
  "author": "Hanzo AI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/extension.git",
    "directory": "packages/gitlab"
  }
}
