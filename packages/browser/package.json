    "@hanzo/usage": "catalog:",
    "@hanzogui/config": "catalog:",
    "@hanzogui/lucide-icons-2": "catalog:",
    "@supabase/supabase-js": "catalog:",
    "axios": "catalog:",
    "chalk": "catalog:",
    "commander": "catalog:",
    "react-native-web": "catalog:",
    "webextension-polyfill": "catalog:",
    "ws": "catalog:",
    "@hanzo/logo": "catalog:",
    "react-hook-form": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/chrome": "catalog:",
    "@types/firefox-webext-browser": "catalog:",
    "@types/jsdom": "catalog:",
    "@types/ws": "catalog:",
    "esbuild": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "ws": "catalog:"
