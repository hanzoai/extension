{
  "name": "hanzo-ide",
  "displayName": "Hanzo AI",
  "description": "Hanzo AI for VS Code: the @hanzo chat participant and an MCP server that gives AI tools access to your workspace.",
  "version": "1.9.31",
  "publisher": "hanzo-ai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/extension.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "productivity",
    "AI",
    "IDE",
    "MCP",
    "chat"
  ],
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#C80000",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:hanzo.login",
    "onCommand:hanzo.logout",
    "onCommand:hanzo.debug.authState",
    "onCommand:hanzo.debug.clearAuth"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "hanzo",
        "name": "Hanzo",
        "description": "Chat with Hanzo AI using your workspace tools",
        "isSticky": true
      }
    ],
    "commands": [
      {
        "command": "hanzo.login",
        "title": "Hanzo: Login"
      },
      {
        "command": "hanzo.logout",
        "title": "Hanzo: Logout"
      },
      {
        "command": "hanzo.debug.authState",
        "title": "Hanzo Debug: Check Auth State",
        "enablement": "isDevelopment"
      },
      {
        "command": "hanzo.debug.clearAuth",
        "title": "Hanzo Debug: Clear Auth Data",
        "enablement": "isDevelopment"
      }
    ],
    "configuration": {
      "title": "Hanzo AI",
      "properties": {
        "hanzo.mcp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start the bundled MCP server, which serves the workspace tools over stdio"
        },
        "hanzo.mcp.allowedPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Paths that MCP tools are allowed to access"
        },
        "hanzo.mcp.disableWriteTools": {
          "type": "boolean",
          "default": false,
          "description": "Disable all write operations in MCP tools"
        },
        "hanzo.mcp.disableSearchTools": {
          "type": "boolean",
          "default": false,
          "description": "Disable all search operations in MCP tools"
        },
        "hanzo.mcp.enabledTools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "List of explicitly enabled MCP tools"
        },
        "hanzo.mcp.disabledTools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "List of explicitly disabled MCP tools"
        },
        "hanzo.llm.provider": {
          "type": "string",
          "enum": [
            "hanzo",
            "lmstudio",
            "ollama"
          ],
          "default": "hanzo",
          "description": "LLM provider to use for AI features: hanzo is api.hanzo.ai, the others run on this machine"
        },
        "hanzo.llm.hanzo.model": {
          "type": "string",
          "default": "zen5",
          "description": "Model on api.hanzo.ai; any id GET https://api.hanzo.ai/v1/models lists"
        },
        "hanzo.llm.hanzo.apiKey": {
          "type": "string",
          "description": "Hanzo API key for api.hanzo.ai, used when not signed in (Hanzo: Login)"
        },
        "hanzo.llm.lmstudio.endpoint": {
          "type": "string",
          "default": "http://localhost:1234/v1",
          "description": "LM Studio API endpoint"
        },
        "hanzo.llm.lmstudio.model": {
          "type": "string",
          "description": "Model to use in LM Studio"
        },
        "hanzo.llm.ollama.endpoint": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama API endpoint"
        },
        "hanzo.llm.ollama.model": {
          "type": "string",
          "default": "llama2",
          "description": "Model to use in Ollama"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "tsc -p ./ --noEmit && node scripts/build.js",
    "build": "vsce package --no-dependencies --out dist/hanzo-ide.vsix",
    "lint": "eslint .",
    "test": "vitest run",
    "test:electron": "npm run build && tsc -p tsconfig.test.json && node ./out/test/runTest.js",
    "test:coverage": "c8 npm test",
    "test:vitest:coverage": "vitest --coverage",
    "test:vitest:run": "vitest run --coverage",
    "publish": "vsce publish --packagePath dist/hanzo-ide.vsix && npx ovsx publish dist/hanzo-ide.vsix"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@stylistic/eslint-plugin": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "@types/sinon": "catalog:",
    "@types/vscode": "~1.90.0",
    "@types/ws": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vscode/test-cli": "catalog:",
    "@vscode/test-electron": "catalog:",
    "@vscode/vsce": "catalog:",
    "better-sqlite3": "catalog:",
    "c8": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "glob": "catalog:",
    "mocha": "catalog:",
    "sinon": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "ws": "catalog:",
    "@hanzo/iam": "catalog:"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "axios": "catalog:",
    "zod": "catalog:"
  },
  "private": true
}
