{
  "name": "hanzo-ide",
  "displayName": "Hanzo AI",
  "description": "Hanzo AI for VS Code: Hanzo's MCP server and Hanzo models for every agent, and the @hanzo chat participant.",
  "version": "1.9.33",
  "publisher": "hanzo-ai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/extension.git"
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "productivity",
    "AI",
    "IDE",
    "MCP",
    "chat"
  ],
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#C80000",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:hanzo.login",
    "onCommand:hanzo.logout",
    "onCommand:hanzo.debug.authState",
    "onCommand:hanzo.debug.clearAuth"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "hanzo",
        "name": "Hanzo",
        "description": "Hanzo AI with every MCP tool, Hanzo's included",
        "isSticky": true
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "hanzo",
        "label": "Hanzo"
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "hanzo",
        "displayName": "Hanzo"
      }
    ],
    "commands": [
      {
        "command": "hanzo.login",
        "title": "Hanzo: Login"
      },
      {
        "command": "hanzo.logout",
        "title": "Hanzo: Logout"
      },
      {
        "command": "hanzo.debug.authState",
        "title": "Hanzo Debug: Check Auth State",
        "enablement": "isDevelopment"
      },
      {
        "command": "hanzo.debug.clearAuth",
        "title": "Hanzo Debug: Clear Auth Data",
        "enablement": "isDevelopment"
      }
    ],
    "configuration": {
      "title": "Hanzo AI",
      "properties": {
        "hanzo.mcp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start the bundled MCP server, which serves the workspace tools over stdio"
        },
        "hanzo.mcp.allowedPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Paths that MCP tools are allowed to access"
        },
        "hanzo.mcp.disableWriteTools": {
          "type": "boolean",
          "default": false,
          "description": "Disable all write operations in MCP tools"
        },
        "hanzo.mcp.disableSearchTools": {
          "type": "boolean",
          "default": false,
          "description": "Disable all search operations in MCP tools"
        },
        "hanzo.mcp.enabledTools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "List of explicitly enabled MCP tools"
        },
        "hanzo.mcp.disabledTools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "List of explicitly disabled MCP tools"
        },
        "hanzo.llm.hanzo.model": {
          "type": "string",
          "default": "zen5",
          "description": "Model on api.hanzo.ai for @hanzo when the chat view's model is not a Hanzo model, and for the AI tools; any id GET https://api.hanzo.ai/v1/models lists"
        },
        "hanzo.llm.hanzo.apiKey": {
          "type": "string",
          "description": "Hanzo API key for api.hanzo.ai, used when not signed in (Hanzo: Login)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "tsc -p ./ --noEmit && node scripts/build.js",
    "build": "vsce package --no-dependencies --out dist/hanzo-ide.vsix",
    "lint": "eslint .",
    "test": "vitest run",
    "test:electron": "npm run build && tsc -p tsconfig.test.json && node ./out/test/runTest.js",
    "test:coverage": "c8 npm test",
    "test:vitest:coverage": "vitest --coverage",
    "test:vitest:run": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@stylistic/eslint-plugin": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "@types/sinon": "catalog:",
    "@types/vscode": "~1.104.0",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vscode/test-cli": "catalog:",
    "@vscode/test-electron": "catalog:",
    "@vscode/vsce": "catalog:",
    "better-sqlite3": "catalog:",
    "c8": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "glob": "catalog:",
    "mocha": "catalog:",
    "sinon": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@hanzo/iam": "catalog:"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "axios": "catalog:",
    "zod": "catalog:"
  },
  "private": true
}
