{
  "name": "Hanzo AI",
  "author": {
    "name": "Hanzo AI",
    "email": "support@hanzo.ai",
    "url": "https://hanzo.ai"
  },
  "version": "0.1.0",
  "frameworkVersion": "2.0",
  "defaultLocale": "en",
  "private": true,
  "singleInstall": true,
  "location": {
    "support": {
      "ticket_sidebar": {
        "url": "assets/iframe.html",
        "flexible": true
      }
    }
  },
  "parameters": [
    {
      "name": "hanzo_api_key",
      "type": "password",
      "secure": true,
      "required": true
    },
    {
      "name": "default_model",
      "type": "text",
      "secure": false,
      "required": false,
      "default": "zen5"
    }
  ],
  "domainWhitelist": ["api.hanzo.ai"]
}
