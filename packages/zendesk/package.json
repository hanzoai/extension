{
  "name": "@hanzo/zendesk",
  "version": "1.0.1",
  "description": "Hanzo AI for Zendesk \u2014 a ticket-sidebar Support app (ZAFv2) that summarizes tickets, drafts replies in the agent's voice, suggests next steps, and writes back into the reply box, built on the published @hanzo/ai headless client against api.hanzo.ai.",
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate": "zcli apps:validate dist",
    "package": "zcli apps:package dist"
  },
  "dependencies": {
    "@hanzo/ai": "catalog:",
    "@hanzo/iam": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@zendesk/zcli": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "assets",
    "src",
    "README.md",
    "manifest.json"
  ]
}
