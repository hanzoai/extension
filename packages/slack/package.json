{
  "name": "@hanzo/slack",
  "version": "1.0.1",
  "description": "Hanzo AI in Slack \u2014 slash command, App Home assistant panel, message shortcuts, and interactivity, built on @hanzo/ai, @hanzo/iam, and @hanzo/cards.",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@hanzo/ai": "catalog:",
    "@hanzo/cards": "workspace:*",
    "@hanzo/iam": "catalog:",
    "@slack/bolt": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "keywords": [
    "hanzo",
    "slack",
    "bolt",
    "block-kit",
    "ai",
    "assistant"
  ],
  "author": "Hanzo AI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/extension.git",
    "directory": "packages/slack"
  }
}
