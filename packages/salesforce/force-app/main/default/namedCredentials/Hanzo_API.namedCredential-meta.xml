<?xml version="1.0" encoding="UTF-8"?>
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Hanzo API</label>
    <!--
      The gateway base URL. Apex builds `callout:Hanzo_API/v1/chat/completions`
      and `callout:Hanzo_API/v1/models` on top of this — api.hanzo.ai/v1 only,
      never an /api/ prefix, never v2.
    -->
    <namedCredentialType>SecuredEndpoint</namedCredentialType>
    <calloutUrl>https://api.hanzo.ai</calloutUrl>
    <allowMergeFieldsInBody>false</allowMergeFieldsInBody>
    <allowMergeFieldsInHeader>true</allowMergeFieldsInHeader>
    <generateAuthorizationHeader>true</generateAuthorizationHeader>
    <calloutStatus>Enabled</calloutStatus>
    <externalCredential>Hanzo_API</externalCredential>
    <!--
      Inject the Bearer token from the External Credential's "ApiKey" auth
      parameter. Salesforce resolves {!$Credential.Hanzo_API.ApiKey} at callout
      time from the principal an admin configured — the key is never in Apex or
      in this file.
    -->
    <namedCredentialParameters>
        <parameterName>Authorization</parameterName>
        <parameterType>HttpHeader</parameterType>
        <parameterValue>Bearer {!$Credential.Hanzo_API.ApiKey}</parameterValue>
    </namedCredentialParameters>
</NamedCredential>
