<?xml version="1.0" encoding="UTF-8"?>
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Hanzo API</label>
    <!--
      Custom authentication: the Hanzo API key is a static Bearer token, not an
      OAuth flow. The key itself is NOT in this metadata — after deploy, an admin
      opens Setup → Named Credentials → External Credentials → Hanzo API →
      Principals → HanzoApiPrincipal → Edit, and enters the `sk-…` key as the
      value of the Authentication Parameter named "ApiKey". The parameter is then
      referenced by the Named Credential's header formula. Secrets never live in
      source or metadata.
    -->
    <authenticationProtocol>Custom</authenticationProtocol>
    <externalCredentialParameters>
        <parameterName>HanzoApiPrincipal</parameterName>
        <parameterType>NamedPrincipal</parameterType>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
</ExternalCredential>
